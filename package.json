{
  "name": "tiendita",
  "version": "1.0.1",
  "main": "javascript/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Punto de venta Tiendita",
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.tiendita.pos",
    "productName": "Tiendita",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Tiendita POS"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!*.db"
    ]
  }
}
